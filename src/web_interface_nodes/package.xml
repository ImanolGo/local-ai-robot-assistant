<?xml version="1.0"?>
<package format="3">
  <name>web_interface_nodes</name>
  <version>0.1.0</version>
  <description>Web interface nodes for monitoring and debugging the robot system</description>

  <maintainer email="developer@local-ai-robot.com">Local AI Robot Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Core ROS dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- Custom interfaces -->
  <depend>robot_interfaces</depend>

  <!-- Web framework dependencies -->
  <build_depend>python3-flask</build_depend>
  <build_depend>python3-flask-socketio</build_depend>
  <exec_depend>python3-flask</exec_depend>
  <exec_depend>python3-flask-socketio</exec_depend>

  <!-- Image processing -->
  <build_depend>python3-opencv</build_depend>
  <build_depend>python3-numpy</build_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- JSON handling -->
  <build_depend>python3-json5</build_depend>
  <exec_depend>python3-json5</exec_depend>

  <!-- Testing -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
