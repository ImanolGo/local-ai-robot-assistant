<?xml version="1.0"?>
<package format="3">
  <name>behavioral_nodes</name>
  <version>0.1.0</version>
  <description>Behavioral architecture nodes using BehaviorTree.CPP for decision making and task coordination</description>

  <maintainer email="developer@local-ai-robot.com">Local AI Robot Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Core ROS dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>action_msgs</depend>

  <!-- Custom interfaces -->
  <depend>robot_interfaces</depend>

  <!-- Behavior tree dependencies -->
  <build_depend>behaviortree_cpp_v3</build_depend>
  <exec_depend>behaviortree_cpp_v3</exec_depend>

  <!-- Python behavior tree wrapper -->
  <build_depend>python3-py-trees</build_depend>
  <exec_depend>python3-py-trees</exec_depend>

  <!-- Math and utilities -->
  <build_depend>python3-numpy</build_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- Testing -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
