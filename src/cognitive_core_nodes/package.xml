<?xml version="1.0"?>
<package format="3">
  <name>cognitive_core_nodes</name>
  <version>0.1.0</version>
  <description>Cognitive core nodes for language understanding and reasoning using local LLMs</description>

  <maintainer email="developer@local-ai-robot.com">Local AI Robot Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Core ROS dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- Custom interfaces -->
  <depend>robot_interfaces</depend>

  <!-- Language model dependencies -->
  <build_depend>python3-torch</build_depend>
  <build_depend>python3-transformers</build_depend>
  <exec_depend>python3-torch</exec_depend>
  <exec_depend>python3-transformers</exec_depend>

  <!-- JSON processing -->
  <build_depend>python3-json5</build_depend>
  <exec_depend>python3-json5</exec_depend>

  <!-- Testing -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
