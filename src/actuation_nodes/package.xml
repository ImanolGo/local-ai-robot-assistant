<?xml version="1.0"?>
<package format="3">
  <name>actuation_nodes</name>
  <version>0.1.0</version>
  <description>Motor control and actuation nodes for UART communication with Wave Rover chassis</description>

  <maintainer email="developer@local-ai-robot.com">Local AI Robot Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Core ROS dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- Custom interfaces -->
  <depend>robot_interfaces</depend>

  <!-- Serial communication -->
  <build_depend>python3-serial</build_depend>
  <exec_depend>python3-serial</exec_depend>

  <!-- Math and utilities -->
  <build_depend>python3-numpy</build_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- Testing -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
