#!/usr/bin/env bash
# Activate the virtual environment without PS1 modification
VIRTUAL_ENV_DISABLE_PROMPT=1 source .venv/bin/activate

# Ensure GStreamer and GObject introspection work properly
export GI_TYPELIB_PATH=/usr/lib/aarch64-linux-gnu/girepository-1.0:/usr/lib/girepository-1.0
export GST_PLUGIN_PATH=/usr/lib/aarch64-linux-gnu/gstreamer-1.0

# Add source packages to Python path for development
for pkg_dir in src/*/; do
    if [[ -d "$pkg_dir" ]]; then
        export PYTHONPATH="$(realpath $pkg_dir):$PYTHONPATH"
    fi
done

# Source ROS2 workspace if built
if [[ -f install/setup.bash ]]; then
    source install/setup.bash
fi
