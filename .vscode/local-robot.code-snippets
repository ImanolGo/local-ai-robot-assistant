  "ROS2 Node Template": {
    "prefix": "ros2node",
    "body": [
      "import rclpy",
      "from rclpy.node import Node",
      "from ${1:message_package}.msg import ${2:MessageType}",
      "",
      "",
      "class ${3:NodeName}(Node):",
      "    def __init__(self):",
      "        super().__init__('${4:node_name}')",
      "        ",
      "        # Declare parameters",
      "        self.declare_parameter('${5:param_name}', ${6:default_value})",
      "        ",
      "        # Initialize publishers",
      "        self.publisher = self.create_publisher(",
      "            ${2:MessageType},",
      "            '${7:topic_name}',",
      "            10",
      "        )",
      "        ",
      "        # Initialize subscribers",
      "        self.subscription = self.create_subscription(",
      "            ${2:MessageType},",
      "            '${8:input_topic}',",
      "            self.callback,",
      "            10",
      "        )",
      "        ",
      "        self.get_logger().info('${3:NodeName} initialized')",
      "    ",
      "    def callback(self, msg: ${2:MessageType}):",
      "        \"\"\"Handle incoming messages.\"\"\"",
      "        ${9:pass}",
      "    ",
      "    def destroy_node(self):",
      "        \"\"\"Cleanup on shutdown.\"\"\"",
      "        self.get_logger().info('Shutting down ${3:NodeName}')",
      "        super().destroy_node()",
      "",
      "",
      "def main(args=None):",
      "    rclpy.init(args=args)",
      "    node = ${3:NodeName}()",
      "    ",
      "    try:",
      "        rclpy.spin(node)",
      "    except KeyboardInterrupt:",
      "        pass",
      "    finally:",
      "        node.destroy_node()",
      "        rclpy.shutdown()",
      "",
      "",
      "if __name__ == '__main__':",
      "    main()",
      "$0"
    ],
    "description": "Create a ROS2 node following project conventions"
  },

