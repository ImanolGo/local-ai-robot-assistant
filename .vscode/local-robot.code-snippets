  "TensorRT Inference": {
    "prefix": "trtinfer",
    "body": [
      "def inference(self, input_data: np.ndarray) -> ${1:np.ndarray}:",
      "    \"\"\"Run TensorRT inference.",
      "    ",
      "    Args:",
      "        input_data: Input tensor ${2:(shape)}",
      "        ",
      "    Returns:",
      "        ${3:Output tensor description}",
      "    \"\"\"",
      "    try:",
      "        # Preprocess",
      "        input_tensor = self.preprocess(input_data)",
      "        ",
      "        # Allocate buffers",
      "        h_input = cuda.pagelocked_empty(input_tensor.size, dtype=np.float32)",
      "        h_output = cuda.pagelocked_empty(self.output_size, dtype=np.float32)",
      "        d_input = cuda.mem_alloc(h_input.nbytes)",
      "        d_output = cuda.mem_alloc(h_output.nbytes)",
      "        ",
      "        # Copy input to device",
      "        cuda.memcpy_htod(d_input, h_input)",
      "        ",
      "        # Execute inference",
      "        self.context.execute_v2([int(d_input), int(d_output)])",
      "        ",
      "        # Copy output to host",
      "        cuda.memcpy_dtoh(h_output, d_output)",
      "        ",
      "        # Postprocess",
      "        result = self.postprocess(h_output)",
      "        ",
      "        return result",
      "        ",
      "    except Exception as e:",
      "        self.get_logger().error(f'Inference error: {e}')",
      "        return None",
      "$0"
    ],
    "description": "TensorRT inference method template"
  },

